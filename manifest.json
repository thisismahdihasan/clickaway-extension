{
  "manifest_version": 3,
  "name": "ClickAway",
  "version": "5.2.1",
  "description": "Simplifies repetitive Printify pricing, variant, and listing tasks, saved per product.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://printify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClickAway",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://printify.com/app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "author": "ClickAway",
  "key": ""
}
